# Build a narrowly patched, MPL-2.0-covered copy of the pinned mGBA source.
# The submodule stays unchanged; the exact transformation ships with mTile.
get_filename_component(mtile_gba_source
  "${CMAKE_CURRENT_SOURCE_DIR}/../../third_party/mgba/src/gba/gba.c" REALPATH)
file(READ "${mtile_gba_source}" mtile_gba_original)
string(REPLACE "\r\n" "\n" mtile_gba_original "${mtile_gba_original}")
set(mtile_halt_before "void GBAHalt(struct GBA* gba) {\n\tgba->cpu->nextEvent")
set(mtile_halt_after "void GBAHalt(struct GBA* gba) {\n\t// HALT wakes on the IE&IF level, including an already pending request.\n\tif (gba->memory.io[REG_IE >> 1] & gba->memory.io[REG_IF >> 1]) {\n\t\treturn;\n\t}\n\tgba->cpu->nextEvent")
string(FIND "${mtile_gba_original}" "${mtile_halt_before}" mtile_halt_offset)
if(mtile_halt_offset EQUAL -1)
  message(FATAL_ERROR "Pinned mGBA HALT implementation changed; review the compatibility patch")
endif()
string(REPLACE "${mtile_halt_before}" "${mtile_halt_after}" mtile_gba_patched "${mtile_gba_original}")
set(mtile_gba_generated "${CMAKE_CURRENT_BINARY_DIR}/mgba-compat/gba.c")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/mgba-compat")
file(WRITE "${mtile_gba_generated}" "${mtile_gba_patched}")
get_target_property(mtile_core_sources mgba-core SOURCES)
list(FIND mtile_core_sources "${mtile_gba_source}" mtile_gba_index)
if(mtile_gba_index EQUAL -1)
  message(FATAL_ERROR "Pinned mGBA source list changed; cannot apply the HALT compatibility patch")
endif()
list(REMOVE_ITEM mtile_core_sources "${mtile_gba_source}")
list(APPEND mtile_core_sources "${mtile_gba_generated}")
set_property(TARGET mgba-core PROPERTY SOURCES "${mtile_core_sources}")
