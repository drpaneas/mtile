+
+func TestHeapSmallAllocationAtSpaceEnd(t *testing.T) {
+	for size := uint16(1); size <= 17; size++ {
+		var c Context
+		c.ensureHeap()
+		space := c.activeSpace()
+		for i := range space {
+			space[i] = 0xa5
+		}
+		start := uint32(heapSize) - alignUp4(uint32(size))
+		c.heap.cursor = start
+		ref, err := c.heap.allocObject(ObjString, size)
+		if err != HeapOK {
+			t.Fatalf("size%d: %v", size, err)
+		}
+		header := c.heap.handles[ref]
+		if header.Offset != start || header.Size != size || c.heap.cursor != heapSize {
+			t.Fatalf("allocation metadata changed for size%d", size)
+		}
+		for i, b := range space {
+			want := byte(0xa5)
+			if uint32(i) >= start {
+				want = 0
+			}
+			if b != want {
+				t.Fatalf("size%d byte%d=%02x want%02x", size, i, b, want)
+			}
+		}
+	}
+}
