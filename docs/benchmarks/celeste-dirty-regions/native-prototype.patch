+//go:build !tinygo && !mtile_mode0 && !mtile_tilecanvas
+package runtime
+import "unsafe"
+func clearMaskedTiles(dst unsafe.Pointer, word uint32, mask unsafe.Pointer) {
+ rows := (*[20]uint32)(mask)
+ pixels := (*[FramebufferSize]byte)(dst)
+ for ty, row := range rows {
+  for tx:=0;tx<30;tx++ {
+   if row & (1<<uint(tx)) == 0 {continue}
+   for y:=ty*8;y<ty*8+8;y++ {
+    for x:=tx*8;x<tx*8+8;x++ {pixels[y*ScreenWidth+x] = byte(word)}
+   }
+  }
+ }
+}
