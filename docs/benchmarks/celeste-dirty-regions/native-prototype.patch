+//go:build !mtile_mode0 && !mtile_tilecanvas
+
+package runtime
+
+import (
+	"github.com/drpaneas/mtile/runtime/hw"
+	"testing"
+)
+
+func TestDirtyPresentIndependentPageHistory(t *testing.T) {
+	hw.ResetForTest()
+	var c Context
+	c.InitHardware()
+	for frame := 0; frame < 32; frame++ {
+		// Persistent frames, no-draw freeze frames, multiple clears between uploads,
+		// changed background, and palette-mapped clear indices all occur.
+		if frame%7 == 0 {
+			c.Pal(0, (frame/7)%4, 0)
+		}
+		if frame%6 != 4 && frame%6 != 5 {
+			c.Cls(0)
+			c.Rectfill(frame*7%220, frame*11%148, frame*7%220+12, frame*11%148+10, 14)
+		}
+		if frame%9 == 2 {
+			c.Cls(0)
+			c.Pset(0, 159, 19)
+			c.Cls(0)
+			c.Pset(239, 0, 31)
+		}
+		if frame%6 == 5 {
+			c.Pset(120, 80, frame+8)
+		}
+		if frame == 17 {
+			c.InitHardware()
+		}
+		if frame == 21 {
+			c.SetBlitKind(BlitCPU)
+		}
+		if frame == 22 {
+			c.SetBlitKind(BlitDMA)
+		}
+		c.PrepareHiddenPage()
+		page := c.hiddenPage()
+		for i := 0; i < FramebufferSize; i += 4 {
+			want := uint32(c.framebuffer[i]) | uint32(c.framebuffer[i+1])<<8 | uint32(c.framebuffer[i+2])<<16 | uint32(c.framebuffer[i+3])<<24
+			if got := hw.ReadVRAM32(page + uintptr(i)); got != want {
+				t.Fatalf("frame%d offset%d got%x want%x", frame, i, got, want)
+			}
+		}
+		if got := hw.ReadVRAM32(page + FramebufferSize); got != 0xffffffff {
+			t.Fatalf("padding changed: %x", got)
+		}
+		// Updating one hidden page repeatedly must not consume the other page's history.
+		if frame%5 != 3 {
+			c.FlipPage()
+		}
+	}
+}
