+//go:build !mtile_mode0 && !mtile_tilecanvas
+
+package runtime
+
+import ("github.com/drpaneas/mtile/runtime/hw"; "unsafe")
+
+// markClearRect conservatively includes every written pixel in a clipped
+// screen-space rectangle. Extra pixels are safe: they already contain the
+// remembered clear index or will be cleared along with actual writes.
+//
+//go:noinline
+//go:section .iwram
+func (c *Context) markClearRect(x0, y0, x1, y1 int) {
+	x0 = max(0, x0)
+	y0 = max(0, y0)
+	x1 = min(ScreenWidth-1, x1)
+	y1 = min(ScreenHeight-1, y1)
+	if x0 > x1 || y0 > y1 {
+		return
+	}
+	tx0, tx1 := uint(x0>>3), uint(x1>>3)
+	mask := ((uint32(1) << (tx1 + 1)) - 1) &^ ((uint32(1) << tx0) - 1)
+	for ty := y0 >> 3; ty <= y1>>3; ty++ {
+		c.clearCoverage[ty] |= mask
+	}
+}
+
+//go:noinline
+func (c *Context) clearTrackedFramebuffer(value byte) {
+	word := uint32(value) * 0x01010101
+	full := !c.clearKnown || value != c.clearIndex
+	for row, mask := range c.clearCoverage {
+		if full {
+			c.dirtyClearPending[row] = 0x3fffffff
+		} else {
+			c.dirtyClearPending[row] |= mask
+		}
+	}
+	if full || dirtyClearForceFull {
+		hw.Fill32(c.framebuffer[:], word, FramebufferSize/4)
+	} else {
+		clearMaskedTiles(unsafe.Pointer(&c.framebuffer[0]), word, unsafe.Pointer(&c.clearCoverage[0]))
+	}
+	c.clearKnown = true
+	c.clearIndex = value
+	c.clearCoverage = [20]uint32{}
+}
