@@ -0,0 +1,62 @@
+//go:build !mtile_mode0 && !mtile_tilecanvas
+
+package runtime
+
+// Experimental conservative map coverage. Build once with the packed cache;
+// each bit covers a complete source tile, including any transparent holes.
+func (c *Context) preparePackedClearCoverage(bg int) {
+	c.packedClearCoverage[bg] = [32]uint64{}
+	if c.cart.MapW > 64 || c.cart.MapH > 32 {
+		return
+	}
+	start := int(c.cart.MapPackedLayers[bg].SpanStart)
+	for _, span := range c.cart.MapPackedSpans[start:start+c.mapPackedSpanCount[bg]] {
+		first := uint(span.X) >> 3
+		last := (uint(span.X)+uint(span.Length&0x7fff)-1) >> 3
+		mask := (^uint64(0) << first) & (^uint64(0) >> (63-last))
+		c.packedClearCoverage[bg][span.Y>>3] |= mask
+	}
+}
+
+func translatedClearBits(bits uint64, shift int) uint32 {
+	if shift < 0 {
+		return uint32(bits >> uint(-shift))
+	}
+	return uint32(bits << uint(shift))
+}
+
+// Bounds are clipped source coordinates, with exclusive upper endpoints.
+// Translate the source tiles and include their neighbouring destination tiles
+// for pixel offsets that are not multiples of eight.
+//go:noinline
+//go:section .iwram
+func (c *Context) markClearPackedCoverage(bg, originX, originY, x0, x1, y0, y1 int) {
+	if x0 >= x1 || y0 >= y1 {
+		return
+	}
+	if c.cart.MapW > 64 || c.cart.MapH > 32 {
+		c.markClearRect(x0+originX, y0+originY, x1+originX-1, y1+originY-1)
+		return
+	}
+	first := uint(x0 >> 3)
+	last := uint((x1-1) >> 3)
+	visible := (^uint64(0) << first) & (^uint64(0) >> (63-last))
+	left := uint((x0+originX) >> 3)
+	right := uint((x1+originX-1) >> 3)
+	destMask := (^uint32(0) << left) & (^uint32(0) >> (31-right))
+	shift := originX >> 3
+	for sy := y0 >> 3; sy <= (y1-1)>>3; sy++ {
+		bits := c.packedClearCoverage[bg][sy] & visible
+		mask := translatedClearBits(bits, shift)
+		if originX&7 != 0 {
+			mask |= translatedClearBits(bits, shift+1)
+		}
+		mask &= destMask
+		top := (max(y0, sy*8)+originY) >> 3
+		bottom := (min(y1, sy*8+8)-1+originY) >> 3
+		c.clearCoverage[top] |= mask
+		if top != bottom {
+			c.clearCoverage[bottom] |= mask
+		}
+	}
+}
