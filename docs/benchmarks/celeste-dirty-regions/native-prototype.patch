+//go:build !mtile_mode0 && !mtile_tilecanvas
+
+package runtime
+
+import (
+	"github.com/drpaneas/mtile/runtime/hw"
+	"unsafe"
+)
+
+func (c *Context) resetDirtyPageState() {
+	c.dirtyClearPending = [20]uint32{}
+	c.dirtyPagePending = [2][20]uint32{}
+	c.dirtyPageValid = [2]bool{}
+}
+
+// copyDirtyFramebuffer keeps independent age for each physical VRAM page.
+// Coverage survives no-draw frames; this may copy unchanged foreground tiles,
+// but never loses a cleared old position or a page skipped for multiple frames.
+//
+//go:noinline
+func (c *Context) copyDirtyFramebuffer(dest uintptr) {
+	page := 0
+	if dest == hw.Page1 {
+		page = 1
+	}
+	for row, coverage := range c.clearCoverage {
+		changed := coverage | c.dirtyClearPending[row]
+		c.dirtyPagePending[0][row] |= changed
+		c.dirtyPagePending[1][row] |= changed
+		c.dirtyClearPending[row] = 0
+	}
+	if !c.dirtyPageValid[page] || dirtyPresentForceFull || c.blitKind != BlitDMA {
+		c.copyFramebuffer(dest)
+	} else {
+		copyDirtyPageToVRAM(unsafe.Pointer(&c.framebuffer[0]), dest, unsafe.Pointer(&c.dirtyPagePending[page][0]))
+	}
+	c.dirtyPageValid[page] = true
+	c.dirtyPagePending[page] = [20]uint32{}
+}
