+package runtime
+
+import (
+	"github.com/drpaneas/mtile/runtime/hw"
+	"unsafe"
+)
+
+func copyDirtyPageToVRAM(src unsafe.Pointer, dest uintptr, masks unsafe.Pointer) {
+	for ty := 0; ty < 20; ty++ {
+		mask := *(*uint32)(unsafe.Add(masks, ty*4))
+		for tx := 0; tx < 30; tx++ {
+			if mask&(1<<uint(tx)) == 0 {
+				continue
+			}
+			for y := ty * 8; y < (ty+1)*8; y++ {
+				for x := tx * 8; x < (tx+1)*8; x += 4 {
+					offset := y*ScreenWidth + x
+					hw.SetVRAM32(dest+uintptr(offset), *(*uint32)(unsafe.Add(src, offset)))
+				}
+			}
+		}
+	}
+}
