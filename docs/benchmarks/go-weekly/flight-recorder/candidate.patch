+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRunEditForwardsAbsoluteStallTracePath(t *testing.T) {
+	dir := t.TempDir()
+	script := filepath.Join(dir, "editor.sh")
+	if err := os.WriteFile(script, []byte("#!/bin/sh\nprintf '%s\\n' \"$@\"\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"", "relative-stall.trace", filepath.Join(dir, "absolute.trace")} {
+		var out bytes.Buffer
+		args := []string{"edit", "-editor", script}
+		if path != "" {
+			args = append(args, "-trace-stall", path)
+		}
+		args = append(args, ".")
+		if err := run(args, &out, &bytes.Buffer{}); err != nil {
+			t.Fatal(err)
+		}
+		lines := strings.Split(strings.TrimSpace(out.String()), "\n")
+		if path == "" {
+			if strings.Contains(out.String(), "trace-stall") {
+				t.Fatal("disabled flag forwarded")
+			}
+		} else {
+			want, err := filepath.Abs(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(lines) != 4 || lines[2] != "-trace-stall" || lines[3] != want {
+				t.Fatalf("forwarded arguments: %q", lines)
+			}
+		}
+	}
+}
