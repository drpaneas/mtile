--- /dev/null
+++ b/runtime/mode0_fourbpp_enabled.go
@@ -0,0 +1,14 @@
+//go:build mtile_mode0 && mtile_trial_fourbpp
+
+package runtime
+
+const mode0TrialTileBytes = 32
+const mode0TrialColorFlag = 0
+
+// This intentionally measures runtime packing before adopting ROM format changes.
+func mode0TrialPack(tile []byte) []byte {
+	for i := 0; i < 32; i++ {
+		tile[i] = tile[i*2] | tile[i*2+1]<<4
+	}
+	return tile[:32]
+}
